# ==============================================================================
# Environment Configuration Template
# Copy to .env for local development (do not commit .env)
# ==============================================================================

# Application
ENVIRONMENT=development
APP_NAME="Jet Freight Rate Aggregator"
SECRET_KEY=change-this-in-production-use-strong-random-key-minimum-32-chars

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration (PostgreSQL or SQLite)
# For local dev / AWS Free Tier micro instance:
DATABASE_URL=sqlite+aiosqlite:///./data/rate_aggregator.db
# Or AWS RDS PostgreSQL Free Tier:
# DATABASE_URL=postgresql+asyncpg://jfll_user:password@localhost:5432/rate_aggregator

# AWS S3 (Free Tier: 5GB storage for PDF rate circulars)
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=jfll-rate-sheets-storage
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Multimodal Vision LLM API (for scanned image PDF extraction fallback)
GEMINI_API_KEY=your-gemini-api-key

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
