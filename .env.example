# ==============================================================================
# Environment Configuration Template
# Copy to .env for local development (do not commit .env)
# ==============================================================================

# Application
ENVIRONMENT=development
APP_NAME="Jet Freight Rate Aggregator"
SECRET_KEY=change-this-in-production-use-strong-random-key-minimum-32-chars

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# AWS S3 (Dedicated storage for PDF rate circulars & frontend hosting)
AWS_REGION=ap-southeast-2
AWS_S3_FRONTEND_BUCKET=jfll-rate-frontend
AWS_S3_STORAGE_BUCKET=jfll-rate-storage
AWS_S3_BUCKET_NAME=jfll-rate-storage
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Multimodal Vision LLM API (for scanned image PDF extraction fallback)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
